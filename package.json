{
  "name": "inventory-management-system",
  "version": "1.0.0",
  "description": "Full-stack MERN Inventory Management System",
  "main": "server.js",
  "scripts": {
    "server": "npm run dev --prefix backend",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install-all": "npm install --prefix backend && npm install --prefix frontend && npm install"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
